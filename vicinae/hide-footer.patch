+ImageURL RootItemManager::itemIcon(const RootItem &item) const {
+  auto it = m_metadata.find(item.uniqueId());
+  if (it != m_metadata.end() && it->second.icon) {
+    const auto &custom = *it->second.icon;
+    if (custom.empty() || custom == "none") return ImageURL{};
+    return ImageURL(ImageLikeModel(ExtensionImageModel{.source = QString::fromStdString(custom)}));
+  }
+  return item.iconUrl();
+}
